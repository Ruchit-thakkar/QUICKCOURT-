# QuickCourt Firebase Client Configuration
# Obtain these values from your Firebase Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=quickcourt-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=quickcourt-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=quickcourt-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ImageKit Configuration (Server-Side Private Key & CDN Endpoint)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
