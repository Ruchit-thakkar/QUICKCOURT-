# QuickCourt Firebase Client Configuration
# Obtain these values from your Firebase Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=quickcourt-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=quickcourt-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=quickcourt-app.appspot.com
