rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection:
    // - Authenticated users can read and write only their own user profile document
    // - No user can read or overwrite another user's document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Businesses collection (prepared architecture):
    // - Anyone can read business public details (for public player discovery)
    // - Only the business owner can create or update their business document
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Bookings collection (Owner & Customer booking records):
    // - Authenticated owner can read and manage bookings belonging to their venues (ownerId == request.auth.uid)
    // - Customer can create booking or read their own booking
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.customer.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.customer.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.customer.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
